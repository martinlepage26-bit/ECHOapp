# ECHO backend configuration. Copy to backend/.env and fill in.
# backend/.env is gitignored — never commit real keys.

# --- Speech provider -----------------------------------------------------------
# Who serves speech: piper | workers_ai | elevenlabs | openai
#   piper      — neural TTS on this machine. Free, offline, no key. TTS only (no dictation).
#   workers_ai — Cloudflare Workers AI edge (Aura-2 TTS + Whisper STT). Deploy workers/echo-ai.
#   elevenlabs — hosted, premium voices. Billed per character.
#   openai     — hosted. Billed per character. Cheaper than ElevenLabs.
SPEECH_PROVIDER=piper

# Piper (SPEECH_PROVIDER=piper). No key. Voices are .onnx files on disk.
PIPER_VOICE_DIR=/home/martin/.local/share/piper-voices
PIPER_DEFAULT_VOICE=en_GB-jenny_dioco-medium

# Cloudflare Workers AI (SPEECH_PROVIDER=workers_ai)
# Deploy: cd workers/echo-ai && npx wrangler deploy
# Secret on the Worker: wrangler secret put ECHO_API_KEY
WORKERS_AI_URL=https://echo-ai.<account>.workers.dev
# Same value as the Worker's ECHO_API_KEY secret (falls back to ECHO_API_KEY below).
WORKERS_AI_TOKEN=
WORKERS_AI_DEFAULT_VOICE=athena

# ElevenLabs (SPEECH_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
# Optional. Defaults to the first voice in the catalog.
ELEVENLABS_DEFAULT_VOICE=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# OpenAI (SPEECH_PROVIDER=openai) — materially cheaper per character than ElevenLabs.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_STT_MODEL=whisper-1

# --- API gate ------------------------------------------------------------------
# Required on any public URL: gates TTS/STT/parse-file AND drafts/transcripts.
# The web client ships the same value as EXPO_PUBLIC_ECHO_KEY (bundled into JS).
# That is a shared gate, not a user secret — rebuild the frontend when you rotate it.
# Pair with rate limits (below) and prefer a reverse-proxy/session layer for public deploys.
ECHO_API_KEY=

# Soft per-IP rate limit on expensive routes (TTS/STT/parse-file). Set MAX=0 to disable.
ECHO_RATE_LIMIT_WINDOW_S=60
ECHO_RATE_LIMIT_MAX=30

# --- CORS ----------------------------------------------------------------------
# Leave empty when the backend serves the Expo web build from the same origin (default).
# Split-origin local dev example:
#   CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Use * only for throwaway debugging (never with cookies/credentials).
CORS_ORIGINS=

# --- Storage -------------------------------------------------------------------
# Drafts and transcripts. Absent, the app still boots and reads back text; only the
# drafts/transcripts endpoints return 503.
# A MongoDB container is already listening on this host at 127.0.0.1:27019.
MONGO_URL=mongodb://127.0.0.1:27019
DB_NAME=echo
