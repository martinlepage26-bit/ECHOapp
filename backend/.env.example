# ECHO backend configuration. Copy to backend/.env and fill in.
# backend/.env is gitignored — never commit real keys.

# --- Speech provider -----------------------------------------------------------
# Who serves speech: piper | elevenlabs | openai
#   piper      — neural TTS on this machine. Free, offline, no key. TTS only (no dictation).
#   elevenlabs — hosted, premium voices. Billed per character.
#   openai     — hosted. Billed per character. Cheaper than ElevenLabs.
SPEECH_PROVIDER=piper

# Piper (SPEECH_PROVIDER=piper). No key. Voices are .onnx files on disk.
PIPER_VOICE_DIR=/home/martin/.local/share/piper-voices
PIPER_DEFAULT_VOICE=en_GB-jenny_dioco-medium

# ElevenLabs (SPEECH_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
# Optional. Defaults to the first voice in the catalog.
ELEVENLABS_DEFAULT_VOICE=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# OpenAI (SPEECH_PROVIDER=openai) — materially cheaper per character than ElevenLabs.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_STT_MODEL=whisper-1

# --- API gate ------------------------------------------------------------------
# Required on any public URL: gates the expensive endpoints (tts/stt/parse-file).
# Note it is compiled into the web bundle, so rebuild the frontend if you rotate it.
ECHO_API_KEY=

# --- Storage -------------------------------------------------------------------
# Drafts and transcripts. Absent, the app still boots and reads back text; only the
# drafts/transcripts endpoints return 503.
# A MongoDB container is already listening on this host at 127.0.0.1:27019.
MONGO_URL=mongodb://127.0.0.1:27019
DB_NAME=echo
