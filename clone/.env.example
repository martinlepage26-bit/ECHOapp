# ECHO clone sidecar environment
#
# Copy this file to clone/.env and load it before starting the server, or point
# the systemd unit at it with EnvironmentFile=.

# Required when the sidecar is exposed to the public internet (production).
# The Worker must send the same value in the X-Echo-Key header.
ECHO_API_KEY=change-me

# Directory containing the reference MP3 samples.
# Defaults to the voices/ directory next to engine.py if unset.
VOICE_SAMPLES_DIR=/home/martin/work/web-apps/ECHOapp/clone/voices

# Optional: cache directory for SpeechT5 / speaker-encoder models and OpenVoice
# checkpoints. Defaults to clone/.cache/ if unset.
ECHO_MODEL_CACHE=/home/martin/work/web-apps/ECHOapp/clone/.cache
