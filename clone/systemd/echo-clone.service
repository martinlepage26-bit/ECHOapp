# ECHO clone TTS sidecar — systemd --user unit.
#
# Install / enable with:
#   systemctl --user enable --now /home/martin/work/web-apps/ECHOapp/clone/systemd/echo-clone.service
# Or copy this file to ~/.config/systemd/user/ first.
#
# Status / logs:
#   systemctl --user status echo-clone.service
#   journalctl --user -u echo-clone.service -f

[Unit]
Description=ECHO clone TTS sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust WorkingDirectory and ExecStart to match your checkout and Python venv.
WorkingDirectory=%h/work/web-apps/ECHOapp/clone
Environment=PYTHONUNBUFFERED=1
Environment=VOICE_SAMPLES_DIR=%h/work/web-apps/ECHOapp/clone/voices
# Load ECHO_API_KEY and any other secrets from a file readable only by the owner.
# EnvironmentFile=%h/.config/echo-clone/clone.env
ExecStart=%h/work/web-apps/ECHOapp/clone/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8099 --log-level info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
