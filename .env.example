# ECHO local development secrets (copy to .dev.vars at repo root)
# Never commit real values.

# Shared API key gates the Worker API and the clone sidecar.
ECHO_API_KEY=your-secret-key

# Origin of the clone TTS sidecar (required for echo/patricia/martin-* voices).
ECHO_CLONE_TTS_URL=https://echo-clone-api.example.com

# Build-time UI config.
VITE_ECHO_API_KEY=your-secret-key
VITE_API_BASE=/echo
