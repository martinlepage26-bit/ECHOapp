{
  "name": "echo-read-flow",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint src worker test",
    "check": "npm run lint && npm test && npm run test:companion && npm run test:xtts",
    "test:companion": "python3 -m unittest discover -s companion -p 'test_*.py'",
    "test:xtts": "python3 -m unittest discover -s deploy/xtts -p 'test_*.py'",
    "voice:local": "python3 companion/server.py"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "pdfjs-dist": "^4.9.155",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.4.11",
    "wrangler": "^4.111.0"
  }
}
